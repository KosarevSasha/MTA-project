# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Запуск: uv run --env-file .env uvicorn mta_project.mta_server:app

# {device_id: ключ}, ключ не короче 32 символов
MTA_DEVICE_KEYS='{"MTA-001": "replace-with-a-device-key-of-32+-chars"}'

# pbkdf2_sha256$раунды$соль_hex$хеш_hex (раундов не менее 200000), см. README п. 5
# ВАЖНО: значение в одинарных кавычках, иначе $ разворачивается как переменная
MTA_ADMIN_PASSWORD_HASH='pbkdf2_sha256$310000$salt_hex$hash_hex'

# секрет подписи сессий, не короче 40 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MTA_SESSION_SECRET=

MTA_DB_PATH=mta.db
# 1 — флаг Secure для cookie (только при HTTPS)
MTA_HTTPS=0

# параметры uvicorn (читаются им из окружения)
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8001
